{
  "name": "streamdeck-deej",
  "productName": "streamdeck-deej",
  "desktopName": "streamdeck-deej",
  "description": "Desktop app for controlling StreamDeck buttons and DeeJ audio sliders via Arduino",
  "license": "MIT",
  "version": "4.0.6",
  "author": {
    "name": "LACHAUX Remi",
    "email": "contact@remi-lachaux.fr",
    "url": "https://www.remi-lachaux.fr"
  },
  "homepage": "https://github.com/lachaux-remi/StreamDeckDeeJ-App",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package:linux": "electron-vite build && node scripts/prepare-package.mjs && electron-builder --linux --publish never",
    "build:linux": "pnpm typecheck && pnpm package:linux",
    "verify:update-metadata": "node scripts/verify-linux-update-metadata.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.33.0",
    "node-hid": "^3.4.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "7.8.5",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "42.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "js-yaml": "^5.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
