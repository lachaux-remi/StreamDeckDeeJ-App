{
  "name": "streamdeck-deej",
  "productName": "streamdeck-deej",
  "description": "Desktop app for controlling StreamDeck buttons and DeeJ audio sliders via Arduino",
  "license": "MIT",
  "version": "4.0.3",
  "author": {
    "name": "LACHAUX Remi",
    "email": "contact@remi-lachaux.fr",
    "url": "https://www.remi-lachaux.fr"
  },
  "homepage": "https://github.com/lachaux-remi/StreamDeckDeeJ-App",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "node-hid": "^3.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^12.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-hid",
      "serialport",
      "@serialport/bindings-cpp",
      "electron",
      "esbuild"
    ]
  }
}
